@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (NOT DEFINED LIBSEPP_LIBGS_INSTALL_PREFIX)
	set(LIBSEPP_LIBGS_INSTALL_PREFIX "@LIBSEPP_LIBGS_INSTALL_PREFIX@")
endif ()

if (LIBSEPP_LIBGS_INSTALL_PREFIX)
	find_dependency(LibGS CONFIG REQUIRED COMPONENTS coro utils
		PATHS "${LIBSEPP_LIBGS_INSTALL_PREFIX}"
		NO_DEFAULT_PATH
	)
else ()
	find_dependency(LibGS CONFIG REQUIRED COMPONENTS coro utils
		HINTS "${PACKAGE_PREFIX_DIR}"
	)
endif ()

if (@LIBEMPP_PACKAGE_NEEDS_CYCLONEDDS@)
	find_dependency(CycloneDDS)
endif ()

if (@LIBEMPP_BUILD_LINUX@ OR @LIBEMPP_PACKAGE_NEEDS_DBUS@)
	find_dependency(PkgConfig)
endif ()

if (@LIBEMPP_BUILD_LINUX@)
	pkg_check_modules(LIBEMPP_UDEV REQUIRED IMPORTED_TARGET libudev)
endif ()

if (@LIBEMPP_PACKAGE_NEEDS_BLKID@)
	pkg_check_modules(LIBEMPP_BLKID REQUIRED IMPORTED_TARGET blkid)
endif ()

if (@LIBEMPP_PACKAGE_NEEDS_GPIOD@)
	pkg_check_modules(LIBEMPP_GPIOD REQUIRED IMPORTED_TARGET libgpiod)
endif ()

if (@LIBEMPP_PACKAGE_NEEDS_DBUS@)
	pkg_check_modules(LIBEMPP_DBUS REQUIRED IMPORTED_TARGET dbus-1)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/libEMppTargets.cmake")

set(libEMpp_VERSION "@PROJECT_VERSION@")
set(libEMpp_core_FOUND TRUE)
set(libEMpp_linux_FOUND @LIBEMPP_BUILD_LINUX@)

set(_libempp_missing_components)
foreach(_libempp_component IN LISTS libEMpp_FIND_COMPONENTS)
	if (NOT DEFINED libEMpp_${_libempp_component}_FOUND)
		set(libEMpp_${_libempp_component}_FOUND FALSE)
	endif ()
	if (NOT libEMpp_${_libempp_component}_FOUND AND
		libEMpp_FIND_REQUIRED_${_libempp_component})
		list(APPEND _libempp_missing_components ${_libempp_component})
	endif ()
endforeach()

if (_libempp_missing_components)
	list(JOIN _libempp_missing_components ", " _libempp_missing_components_text)
	set(libEMpp_NOT_FOUND_MESSAGE
		"Required libEMpp components are unavailable: "
		"${_libempp_missing_components_text}"
	)
endif ()

# Preserve the source-tree target names for existing add_subdirectory users.
foreach(_libempp_component core linux)
	if (TARGET libEMpp::${_libempp_component} AND
		NOT TARGET empp.${_libempp_component})
		add_library(empp.${_libempp_component} INTERFACE IMPORTED)
		set_property(TARGET empp.${_libempp_component} PROPERTY
			INTERFACE_LINK_LIBRARIES libEMpp::${_libempp_component}
		)
	endif ()
endforeach()

check_required_components(libEMpp)

unset(_libempp_component)
unset(_libempp_missing_components)
unset(_libempp_missing_components_text)
